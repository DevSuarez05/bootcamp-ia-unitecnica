Proceso ejercicio_6
	
	 
		Definir n1, n2, n3, n4, notaDefinitiva Como Real;
		Escribir "Ingrese la primera nota (30%):";
		Leer n1;
		Escribir "Ingrese la segunda nota (30%):";
		Leer n2;
		Escribir "Ingrese la tercera nota (25%):";
		Leer n3;
		Escribir "Ingrese la cuarta nota (15%):";
		Leer n4;
		notaDefinitiva <- (n1 * 0.30) + (n2 * 0.30) + (n3 * 0.25) + (n4 * 0.15);
		Escribir "La nota definitiva es: ", notaDefinitiva;
FinProceso
	

