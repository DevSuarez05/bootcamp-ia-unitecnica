Proceso Ejercicio_5
	

		Escribir "Ingrese el número de lados de la figura: ";
		Leer lados;
		
		Si lados == 3 Entonces
			Escribir "Es un triángulo";
		Sino
			Si lados == 4 Entonces
				Escribir "Es un cuadrado y/o rectángulo";
			Sino
				Escribir "Figura no especificada";
			FinSi
		FinSi
FinAlgoritmo
	

