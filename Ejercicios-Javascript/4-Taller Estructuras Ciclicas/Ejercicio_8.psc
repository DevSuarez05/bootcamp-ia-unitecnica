Proceso Ejercicio_8
	
	
		Definir num, i Como Entero;
		Repetir
			Escribir "Ingrese un numero entero positivo:";
			Leer num;
		Hasta Que num > 0;
		Escribir "Tabla de multiplicar del ", num, ":";
		Para i <- 1 Hasta 10 Con Paso 1 Hacer
			Escribir num, " x ", i, " = ", (num * i);
		FinPara

	
FinProceso
