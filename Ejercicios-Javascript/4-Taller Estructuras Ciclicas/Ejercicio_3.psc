Proceso Ejercicio_3
	

		Definir i Como Entero;
		Definir temp, suma, promedio Como Real;
		suma <- 0;
		Para i <- 1 Hasta 5 Con Paso 1 Hacer
			Escribir "Ingrese la temperatura ", i, ":";
			Leer temp;
			suma <- suma + temp;
		FinPara
		promedio <- suma / 5;
		Escribir "El promedio de las 5 temperaturas es: ", promedio;

	
FinProceso
