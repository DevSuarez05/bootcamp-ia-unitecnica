Proceso Ejercicio_4
	
	
		Definir i Como Entero;
		Definir nota, suma, promedio Como Real;
		suma <- 0;
		Para i <- 1 Hasta 4 Con Paso 1 Hacer
			Escribir "Ingrese la nota ", i, ":";
			Leer nota;
			suma <- suma + nota;
		FinPara
		promedio <- suma / 4;
		Escribir "La calificacion final es: ", promedio;

	
FinProceso
