Proceso ejercicio_9
	
	
		Definir v1, v2, v3, v4, prod, suma, promedio Como Real;
		Escribir "Ingrese cuatro valores separándolos por Enter:";
		Leer v1, v2, v3, v4;
		suma <- v1 + v2 + v3 + v4;
		prod <- v1 * v2 * v3 * v4;
		promedio <- suma / 4;
		Escribir "La suma es: ", suma;
		Escribir "El producto es: ", prod;
		Escribir "El promedio es: ", promedio;
FinProceso
	
