Proceso ejercicio_5
	 
		Definir compra, descuento, totalPagar Como Real;
		Escribir "Ingrese el valor total de la compra:";
		Leer compra;
		descuento <- compra * 0.10;
		totalPagar <- compra - descuento;
		Escribir "El descuento aplicado es de: $", descuento;
		Escribir "El total a pagar es: $", totalPagar;
FinProceso
	

